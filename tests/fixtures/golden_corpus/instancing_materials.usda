    }

    def "mtl"
    {
        def Material "Good"
        {
            token outputs:surface.connect = </World/mtl/Good/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                token outputs:surface
            }
        }

        def Material "NoSurfaceB"
        {
        }

        def Material "NoSurfaceA"
        {
        }

        def Material "Unused"
        {
        }
    }

    def "geo"
    {
        def Mesh "Bound" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            rel material:binding = </World/mtl/Good>
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        }

        def Mesh "PurposeBound" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            rel material:binding:preview = </World/mtl/NoSurfaceA>
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        }

        def Mesh "SubsetOnly"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]

            def GeomSubset "face0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/mtl/NoSurfaceB>
            }

            def GeomSubset "face1"
            {
            }
        }

        def "Orphan"
        {
            def GeomSubset "subset"
            {
            }
        }
    }

