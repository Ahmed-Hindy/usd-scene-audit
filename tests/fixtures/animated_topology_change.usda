#usda 1.0
(
    """A mesh whose point count changes mid-sequence while faceVertexIndices
    stays static, and whose points go non-finite at frame 5.

    Both defects are real, and at the audited time code -- frame 1, this stage's
    startTimeCode -- the mesh is perfectly valid, so the default audit reports
    nothing. Each individual defect is reachable by auditing the frame it occurs
    on: `--frame 5` finds the non-finite point, `--frame 8` finds the indices
    that are out of range against the reduced point count.

    What no single-frame audit can establish is that the point count *changed*
    between frames while the topology stayed static. That requires comparing
    samples, which is tracked separately.

    This fixture exists to pin down current behaviour -- the audit must report
    no *false* findings at the default time code -- and to be the regression
    target once time-varying checks land.
    """
    defaultPrim = "World"
    endTimeCode = 8
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "BadCache"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points.timeSamples = {
            1: [(0, 0, 0), (1, 0, 0), (0, 1, 0)],
            5: [(nan, 0, 0), (1, 0, 0), (0, 1, 0)],
            8: [(0, 0, 0)],
        }
    }
}
