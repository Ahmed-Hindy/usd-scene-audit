#usda 1.0
(
    """A valid deforming mesh whose points exist only as time samples.

    This is the normal authoring pattern for any deforming geometry: a
    simulation cache, cloth, a crowd agent, or imported Alembic. There is no
    default value for `points`, so reading the attribute at
    Usd.TimeCode.Default() resolves to None and the mesh looks like it is
    missing its point data entirely.

    The audit must report zero findings for this stage.
    """
    defaultPrim = "World"
    endTimeCode = 3
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Cloth"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points.timeSamples = {
            1: [(0, 0, 0), (1, 0, 0), (0, 1, 0)],
            2: [(0, 0, 1), (1, 0, 1), (0, 1, 1)],
            3: [(0, 0, 2), (1, 0, 2), (0, 1, 2)],
        }
    }
}
