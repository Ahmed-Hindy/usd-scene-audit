#usda 1.0
(
    """A valid deforming mesh whose points, normals, extent, and UV primvar are
    all authored purely as time samples.

    Every time-varying attribute the geometry audit reads is covered here, so a
    default-time read produces a cascade of false findings: missing points,
    out-of-range indices, and normals/primvar length mismatches against a point
    count of zero.

    The audit must report zero findings for this stage.
    """
    defaultPrim = "World"
    endTimeCode = 2
    metersPerUnit = 1
    startTimeCode = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Deforming"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        normal3f[] normals (
            interpolation = "vertex"
        )
        normal3f[] normals.timeSamples = {
            1: [(0, 0, 1), (0, 0, 1), (0, 0, 1)],
            2: [(0, 1, 0), (0, 1, 0), (0, 1, 0)],
        }
        point3f[] points.timeSamples = {
            1: [(0, 0, 0), (1, 0, 0), (0, 1, 0)],
            2: [(0, 0, 1), (1, 0, 1), (0, 1, 1)],
        }
        float3[] extent.timeSamples = {
            1: [(0, 0, 0), (1, 1, 0)],
            2: [(0, 0, 1), (1, 1, 1)],
        }
        texCoord2f[] primvars:st (
            interpolation = "vertex"
        )
        texCoord2f[] primvars:st.timeSamples = {
            1: [(0, 0), (1, 0), (0, 1)],
            2: [(0, 0), (1, 0), (0, 1)],
        }
    }
}
